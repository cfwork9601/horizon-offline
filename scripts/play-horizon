#!/usr/bin/env bash
# play-horizon: Direct launcher for Horizon (Minecraft Rust Edition) without Microsoft login
set -e

# Find the newest installed Horizon version in ~/.local/share/horizon-launcher/versions
VERSION_DIR="$(ls -d "${HOME}/.local/share/horizon-launcher/versions/nightly-"* 2>/dev/null | tail -n 1)"
if [ -z "$VERSION_DIR" ]; then
    VERSION_DIR="$(ls -d "${HOME}/.local/share/horizon-launcher/versions/"* 2>/dev/null | tail -n 1)"
fi

if [ -z "$VERSION_DIR" ] || [ ! -x "${VERSION_DIR}/horizon-client" ]; then
    echo "Error: Horizon client binary not found in ~/.local/share/horizon-launcher/versions" >&2
    echo "Please run install.sh first to set up Horizon and prepare game resources." >&2
    exit 1
fi

RESOURCES="${VERSION_DIR}/.local/horizon-client/26.3"
if [ ! -d "$RESOURCES" ]; then
    echo "Error: Prepared resources not found at $RESOURCES" >&2
    echo "Run: horizon-launcher prepare --minecraft <path_to_minecraft_folder>" >&2
    exit 1
fi

GAME_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/horizon"
mkdir -p "$GAME_DIR"

exec "${VERSION_DIR}/horizon-client" --resources "$RESOURCES" --game-dir "$GAME_DIR" "$@"
